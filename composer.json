{
    "name": "modera/backend-google-analytics-config-bundle",
    "type": "symfony-bundle",
    "description": "Provide UI access to configuration properties from 'analytics' category.",
    "license": "MIT",
    "authors": [
        {
            "name": "Sergei Lissovski"
        },
        {
            "name": "Sergei Vizel"
        }
    ],
    "require": {
        "php": ">=8.1",
        "modera/backend-config-utils-bundle": "^5.0|^6.0",
        "modera/backend-tools-settings-bundle": "^5.0|^6.0",
        "modera/config-bundle": "^5.0|^6.0",
        "modera/expander-bundle": "^5.0|^6.0",
        "modera/mjr-security-integration-bundle": "^5.0|^6.0"
    },
    "require-dev": {
        "phake/phake": "^4.0",
        "phpunit/phpunit": "^10.5",
        "symfony/symfony": "^6.0"
    },
    "autoload": {
        "psr-4": { "Modera\\BackendGoogleAnalyticsConfigBundle\\": "" }
    },
    "extra": {
        "modera-module": {
            "register-bundle": "Modera\\BackendGoogleAnalyticsConfigBundle\\ModeraBackendGoogleAnalyticsConfigBundle"
        },
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    }
}
